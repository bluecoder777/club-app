# Docker Compose Credentials
POSTGRES_USER=clubuser
POSTGRES_PASSWORD=clubpassword
POSTGRES_DB=club

# Backend Connection String (pointing to the internal Docker network db container)
DB_URL=jdbc:postgresql://db:5432/club
# JWT Secret Keys (must be at least 256 bits/32 chars for HMAC-SHA256)
JWT_ACCESS_SECRET=access_super_secret_key_for_club_app_jwt_authentication_2026_xYz
JWT_REFRESH_SECRET=refresh_super_secret_key_for_club_app_jwt_authentication_2026_xYz

# JWT Expiration in milliseconds
# Access Token: 15 minutes (900000 ms)
JWT_ACCESS_EXPIRY=900000

# Refresh Token: 7 days (604800000 ms)
JWT_REFRESH_EXPIRY=604800000
